PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/promotr
REDIS_URL=redis://localhost:6379
PUBLIC_BASE_URL=http://localhost:4000

# Set DEV_MODE=true to log OTPs to console (skip MSG91)
DEV_MODE=true

# MSG91 OTP API credentials (required when DEV_MODE=false for phone OTP)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
MSG91_OTP_EXPIRY_MINUTES=1
